{
  "name": "@taza/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../.env -- tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma": "dotenv -e ../.env -- prisma",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "db:studio": "dotenv -e ../.env -- prisma studio",
    "seed": "dotenv -e ../.env -- prisma migrate deploy && dotenv -e ../.env -- tsx prisma/seed/index.ts",
    "test": "vitest run",
    "ai:test": "dotenv -e ../.env -- tsx scripts/ai-test.ts",
    "bot:sim": "dotenv -e ../.env -- tsx scripts/bot-sim.ts",
    "start": "node --env-file=../.env dist/src/index.js",
    "demo:seed": "dotenv -e ../.env -- tsx prisma/seed/demo.ts",
    "demo:reset": "dotenv -e ../.env -- tsx prisma/seed/reset.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@huggingface/transformers": "^4.3.0",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "grammy": "^1.46.0",
    "pino": "^10.3.1",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
