DATABASE_URL=postgresql://taza:taza@localhost:5432/taza
TELEGRAM_BOT_TOKEN=            # токен от @BotFather — только в .env
TELEGRAM_MODE=polling          # polling | webhook
PUBLIC_URL=http://localhost:3000
ANTHROPIC_API_KEY=             # если пусто — включается MOCK-классификатор
AI_MODEL=claude-sonnet-5
AI_PROVIDER=auto              # auto: claude (если есть ключ) → clip (локально) → mock
MODELS_DIR=./models           # кэш локальной модели CLIP (~150 МБ)
JWT_SECRET=change-me
ADMIN_EMAIL=admin@taza.kz
ADMIN_PASSWORD=admin123
PORT=3000
UPLOADS_DIR=./uploads
