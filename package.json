{
  "name": "taza-kaspiy",
  "private": true,
  "version": "0.1.0",
  "description": "Таза Каспий — мониторинг загрязнения побережья Каспия (Актау, Мангистау)",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "seed": "npm run seed -w server",
    "dev:server": "npm run dev -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "ai:test": "npm run ai:test -w server --",
    "test": "npm test -w server",
    "bot:sim": "npm run bot:sim -w server --",
    "dev:web": "npm run dev -w web",
    "build:web": "npm run build -w web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-vue": "^10.11.1",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "onnxruntime-node": false,
    "protobufjs": false
  }
}
